<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>TEST - ExpenseTrack</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/PersonalExpenseTracker.styles.css"
          asp-append-version="true" />
</head>

<body class="app-body">

    <!-- NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
            <div class="container">

                <!-- Brand -->
                <a class="navbar-brand fw-bold"
                   asp-controller="Dashboard"
                   asp-action="Index">

                    <span class="brand-icon">₹</span>
                    ExpenseTrack
                </a>

                <!-- Mobile button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation -->
                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Dashboard"
                               asp-action="Index">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Income"
                               asp-action="Index">
                                Income
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Expense"
                               asp-action="Index">
                                Expenses
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="SavingsGoal"
                               asp-action="Index">
                                Savings Goals
                            </a>
                        </li>

                        <li class="nav-item ms-lg-3">
                            <a class="btn btn-outline-light btn-sm px-3"
                               asp-controller="Account"
                               asp-action="Logout">
                                Logout
                            </a>
                        </li>

                    </ul>

                </div>
            </div>
        </nav>
    </header>


    <!-- MAIN CONTENT -->
    <main>
        @RenderBody()
    </main>


    <!-- FOOTER -->
    <footer class="app-footer">
        <div class="container text-center">
            <span>
                © 2026 ExpenseTrack · Personal Expense Management System
            </span>
        </div>
    </footer>


    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>