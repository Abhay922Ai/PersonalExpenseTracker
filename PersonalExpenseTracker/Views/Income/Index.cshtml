@model List<PersonalExpenseTracker.Models.Income>

@{
    ViewData["Title"] = "Income";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Income</h2>
            <p class="text-muted mb-0">Track and monitor your incoming funds</p>
        </div>

        <a asp-action="Add" class="btn btn-primary">
            + Add Income
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card p-5 text-center shadow-sm">
            <div class="mb-3" style="font-size: 2.5rem;">💰</div>
            <h4>No income records found</h4>
            <p class="text-muted">Click the button below to record your first income.</p>
            <div>
                <a asp-action="Add" class="btn btn-primary">
                    + Add Income
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Source</th>
                            <th>Amount</th>
                            <th>Date</th>
                            <th>Description</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var income in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                        @income.Source
                                    </span>
                                </td>
                                <td class="fw-bold text-success">
                                    + ₹@income.Amount.ToString("N2")
                                </td>
                                <td>
                                    @income.IncomeDate.ToString("dd MMM yyyy")
                                </td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(income.Description) ? "-" : income.Description)
                                </td>
                                <td class="text-end">
                                    <form asp-action="Delete" asp-route-id="@income.IncomeId" method="post" class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this income of ₹@income.Amount.ToString("N2")?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete Income">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>
