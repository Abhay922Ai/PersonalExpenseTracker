@model List<PersonalExpenseTracker.Models.Income>

@{
    ViewData["Title"] = "Income";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Income</h2>

        <a asp-action="Add" class="btn btn-primary">
            + Add Income
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No income records found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped">

                <thead>
                    <tr>
                        <th>Source</th>
                        <th>Amount</th>
                        <th>Date</th>
                        <th>Description</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var income in Model)
                    {
                        <tr>
                            <td>@income.Source</td>
                            <td>₹@income.Amount.ToString("N2")</td>
                            <td>@income.IncomeDate.ToString("dd-MM-yyyy")</td>
                            <td>@income.Description</td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

</div>