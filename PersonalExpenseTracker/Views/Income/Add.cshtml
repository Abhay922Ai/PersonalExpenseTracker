@model PersonalExpenseTracker.ViewModels.IncomeViewModel

@{
    ViewData["Title"] = "Add Income";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="mb-3">Add Income</h2>
                    <p class="text-muted mb-4">Record new income, salary, or incoming transfer</p>

                    <form asp-action="Add" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Source" class="form-label"></label>
                            <input asp-for="Source" class="form-control"
                                   placeholder="e.g. Salary, Freelancing, Dividends, Bonus" />
                            <span asp-validation-for="Source" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Amount" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="Amount" class="form-control"
                                       type="number" step="0.01" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IncomeDate" class="form-label"></label>
                            <input asp-for="IncomeDate" class="form-control" type="date" />
                            <span asp-validation-for="IncomeDate" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"
                                      placeholder="Optional description"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary px-4">
                                Add Income
                            </button>
                            <a asp-action="Index" class="btn btn-secondary px-4">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
