@model PersonalExpenseTracker.ViewModels.IncomeViewModel

@{
    ViewData["Title"] = "Add Income";
}

<div class="container mt-4">
    <h2>Add Income</h2>

    <form asp-action="Add" method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Source" class="form-label"></label>
            <input asp-for="Source" class="form-control" placeholder="e.g. Salary, Freelancing" />
            <span asp-validation-for="Source" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Amount" class="form-label"></label>
            <input asp-for="Amount" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="IncomeDate" class="form-label"></label>
            <input asp-for="IncomeDate" class="form-control" type="date" />
            <span asp-validation-for="IncomeDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control"
                      placeholder="Optional description"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">
            Add Income
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}