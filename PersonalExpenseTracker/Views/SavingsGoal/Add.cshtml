@model PersonalExpenseTracker.ViewModels.SavingsGoalViewModel

@{
    ViewData["Title"] = "Add Savings Goal";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="mb-3">Add Savings Goal</h2>
                    <p class="text-muted mb-4">Set a target to keep your future plans on track</p>

                    <form asp-action="Add" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="GoalName" class="form-label"></label>
                            <input asp-for="GoalName" class="form-control"
                                   placeholder="e.g. New Laptop, Emergency Fund, Vacation" />
                            <span asp-validation-for="GoalName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TargetAmount" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="TargetAmount" class="form-control"
                                       type="number" step="0.01" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="TargetAmount" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SavedAmount" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="SavedAmount" class="form-control"
                                       type="number" step="0.01" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="SavedAmount" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TargetDate" class="form-label"></label>
                            <input asp-for="TargetDate" class="form-control" type="date" />
                            <span asp-validation-for="TargetDate" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success px-4">
                                Create Savings Goal
                            </button>
                            <a asp-action="Index" class="btn btn-secondary px-4">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
