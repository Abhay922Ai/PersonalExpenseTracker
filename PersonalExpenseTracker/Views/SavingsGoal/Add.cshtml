@model PersonalExpenseTracker.ViewModels.SavingsGoalViewModel

@{
    ViewData["Title"] = "Add Savings Goal";
}

<div class="container mt-4">
    <h2>Add Savings Goal</h2>

    <form asp-action="Add" method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="GoalName" class="form-label"></label>
            <input asp-for="GoalName" class="form-control"
                   placeholder="e.g. New Laptop" />
            <span asp-validation-for="GoalName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TargetAmount" class="form-label"></label>
            <input asp-for="TargetAmount" class="form-control"
                   type="number" step="0.01" />
            <span asp-validation-for="TargetAmount" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SavedAmount" class="form-label"></label>
            <input asp-for="SavedAmount" class="form-control"
                   type="number" step="0.01" />
            <span asp-validation-for="SavedAmount" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TargetDate" class="form-label"></label>
            <input asp-for="TargetDate" class="form-control" type="date" />
            <span asp-validation-for="TargetDate" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">
            Add Savings Goal
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}